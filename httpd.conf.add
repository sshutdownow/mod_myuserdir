# $Id: httpd.conf.add 27 2007-08-05 20:10:51Z igor_popov $
#
# to work properly mod_myuserdir.c should be loaded after php4 module
#
# LoadModule php4_module        libexec/apache/libphp4.so
LoadModule myuserdir_module   libexec/apache/mod_myuserdir.so
#...
# AddModule mod_php4.c
AddModule mod_myuserdir.c
#...
#
<IfModule mod_myuserdir.c>
	MyUserOn	on
	DBDPersist	On
	DBDriver	mysql
	DBDParams	"host=localhost dbname=hosting user=nonpriv pass=M3Ga_PaSsVVd"
	MyUserQuery	"SELECT CONCAT('homedir', 'doc_root'), CONCAT('upload_tmp_dir=homedir/.tmp;', extra_php_config) FROM tilde_users WHERE username='%s' AND enabled='yes' LIMIT 1"

	<Directory "/usr/local/www/homedirs">
	    Options Indexes
	    AllowOverride None
	    Order allow,deny
	    Allow from all
	</Directory>

</IfModule>
